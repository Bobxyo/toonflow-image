# 1) 上游镜像里 /app/build/tools/pluginDeveloper.tool.js 权限为 600 root，
#    容器以 bun 用户启动时读取失败直接崩溃（EACCES）→ 补权限。
# 2) 局域网 http（非 secure context）下 crypto.randomUUID 不存在，前端报
#    "启动失败 crypto.randomUUID is not a function" → 注入 polyfill。
# 3) 设备互联（mobileLink）管理接口断言请求来自容器内 127.0.0.1 且 Host 为
#    localhost；Docker 端口映射后来源是网桥 IP、Host 是局域网 IP，4 项校验
#    两项恒假 → 设置页"设备互联"永远 403。去掉 socket-IP 与 hostname 两项
#    （Origin 同源校验和专用请求头保留，安全性不变）。
FROM ghcr.io/bobxyo/toonflow-app:2.0.10
USER root
RUN chmod -R a+rX /app/build && chown -R bun:bun /app/data
COPY web-polyfill.js /app/build/web/zz-polyfill.js
RUN sed -i 's#<script type="module"#<script src="/zz-polyfill.js"></script><script type="module"#' /app/build/web/index.html \
 && grep -c zz-polyfill /app/build/web/index.html
# mobileLink 403 补丁：仅作用于 build/server/index.js 第一个匹配处（mobileLink 四条管理路由共用），
# 同 pattern 的 remoteConnection / multiTenant 校验（另有 2 处）不受影响。
RUN sed -i '0,/r=\["127.0.0.1","::1","::ffff:127.0.0.1"\].includes(e.socket.remoteAddress??"")/s##r=true#' /app/build/server/index.js \
 && sed -i '0,/if(iP(e)||!r||!i||!n||/s#if(iP(e)||!r||!i||!n||#if(iP(e)||!n||#' /app/build/server/index.js \
 && grep -c 'if(iP(e)||!n||e.get("x-toonflow-mobile-link")' /app/build/server/index.js
USER bun
